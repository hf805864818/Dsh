[
  {
    "name": "host_list",
    "description": "列出这台 iPhone 上某个宿主目录的内容（不进 Linux 环境，直接读真实文件系统）。返回 name/kind/size，目录在前。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "绝对路径，例如 /var/mobile/Documents"
        }
      },
      "required": ["path"]
    }
  },
  {
    "name": "host_read",
    "description": "读取宿主上的一个文本文件。返回 data/bytes/truncated；超过上限会截断并标记 truncated。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "绝对路径"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608,
          "description": "最多读取多少字节，默认 1 MiB"
        }
      },
      "required": ["path"]
    }
  },
  {
    "name": "host_write",
    "description": "写入宿主上的一个文件（先写临时文件再改名，避免半截文件）。会创建父目录不存在的文件失败，请先确认目录存在。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "绝对路径"
        },
        "data": {
          "type": "string",
          "description": "要写入的完整内容"
        }
      },
      "required": ["path", "data"]
    }
  },
  {
    "name": "host_stat",
    "description": "查看宿主上一个路径的类型、大小、权限位与修改时间。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "绝对路径"
        }
      },
      "required": ["path"]
    }
  },
  {
    "name": "host_exec",
    "description": "直接在 iPhone 上执行一个原生程序并取回输出（例如 /bin/ls、/usr/bin/dpkg）。注意：这里跑的是 iOS 上的可执行文件，不是 Linux 环境里的命令；要跑 Linux 命令请用 bash 工具。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "可执行文件的绝对路径"
        },
        "argv": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 64,
          "description": "参数列表，不含程序本身"
        },
        "cwd": {
          "type": "string",
          "description": "工作目录，可省略"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "description": "超时毫秒，默认 30000"
        }
      },
      "required": ["path", "argv"]
    }
  }
]
